DATABASE_URL=postgresql://apple:localdev@localhost:5432/clickup_clone

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Google OAuth ──
# Create at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── Email ──
# EMAIL_PROVIDER: "console" (logs links to terminal) or "resend" (sends real email)
EMAIL_PROVIDER=console
# Get an API key at https://resend.com → API Keys
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend (e.g. "Flowspace <noreply@syspreedigital.com>")
EMAIL_FROM=

# ── Zoom (Server-to-Server OAuth app) ──
# Create at https://marketplace.zoom.us → Develop → Build App → Server-to-Server OAuth
# Grant scope: meeting:write:meeting:admin (and meeting:read:meeting:admin)
ZOOM_ACCOUNT_ID=wHwjDML5SRCZL0rJmSk1WQ
ZOOM_CLIENT_ID=I7_TlvKNR4arDFkyGZYkbg
ZOOM_CLIENT_SECRET=8TBZPliUpP9uPDqANYjLqguJnKslQZcF

STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

CORS_ORIGIN=http://localhost:3000
API_PORT=4000

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# ── Public access mode ──
# When both are set, /login and /register never render — every visitor is
# auto-signed-in as PUBLIC_ACCESS_EMAIL with no password check at all.
# Leave blank/unset (the default) to keep normal login. Turning this on means
# ANYONE who has the URL gets full read/write access as that account — only
# enable it deliberately, and only pointed at an account whose data exposure
# you've accepted. Both vars must be set on the API; the web app also needs
# NEXT_PUBLIC_PUBLIC_ACCESS_MODE=true set at build time (Vercel env var) so the
# login/register pages skip themselves client-side too.
PUBLIC_ACCESS_MODE=false
PUBLIC_ACCESS_EMAIL=
NEXT_PUBLIC_PUBLIC_ACCESS_MODE=false
