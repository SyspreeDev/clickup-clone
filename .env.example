DATABASE_URL=postgresql://apple:localdev@localhost:5432/clickup_clone

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Google OAuth ──
# Create at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── Email ──
# EMAIL_PROVIDER: "console" (logs links to terminal) or "resend" (sends real email)
EMAIL_PROVIDER=console
# Get an API key at https://resend.com → API Keys
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend (e.g. "Flowspace <noreply@syspreedigital.com>")
EMAIL_FROM=

# ── Zoom (Server-to-Server OAuth app) ──
# Create at https://marketplace.zoom.us → Develop → Build App → Server-to-Server OAuth
# Grant scope: meeting:write:meeting:admin (and meeting:read:meeting:admin)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

CORS_ORIGIN=http://localhost:3000
API_PORT=4000

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
